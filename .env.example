# --- App ---
APP_NAME=Esteban Creaciones RAG
DATABASE_URL=postgresql+asyncpg://esteban:esteban@localhost:5432/esteban_creaciones
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chunking ---
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# --- Retrieve ---
RETRIEVE_TOP_K=5
RETRIEVE_MIN_SCORE=0.35

# --- Embeddings provider: local | openai | bedrock ---
EMBEDDING_PROVIDER=local

# local (gratis, FastEmbed/ONNX — sin PyTorch)
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# bge-small-en-v1.5 => 384 dims

# openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small default dims 1536 (se puede bajar con OPENAI_EMBEDDING_DIMENSIONS)
OPENAI_EMBEDDING_DIMENSIONS=1536

# bedrock
AWS_REGION=us-east-1
# Obligatorio si usás SSO: el login renueva ESTE perfil, no el [default]
AWS_PROFILE=ueno-data-gen-ia-lab
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024

# LLMs Bedrock (Converse) — Nova Lite donde aporta calidad/latencia
ROUTER_USE_LLM=true
BEDROCK_ROUTER_MODEL=amazon.nova-lite-v1:0
BEDROCK_GUARDRAIL_MODEL=amazon.nova-lite-v1:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
# Opcional aún más rápido en classify: amazon.nova-micro-v1:0 (router/guardrail)

# Historial: ventana al LLM + cache en memoria (write-through sobre Postgres)
CHAT_HISTORY_WINDOW=6
ROUTER_HISTORY_WINDOW=2
CHAT_HISTORY_CACHE_SESSIONS=256
CHAT_HISTORY_CACHE_KEEP=20
RAG_GENERATE_MIN_SCORE=0.45
GUARDRAILS_ENABLED=true

# --- OpenTelemetry (SDK OSS; backend gratis = Jaeger local) ---
# none | console | otlp
OTEL_ENABLED=true
OTEL_EXPORTER=otlp
OTEL_SERVICE_NAME=esteban-creaciones-rag
OTEL_ENVIRONMENT=local
# Host: docker compose jaeger → localhost:4317
# Desde el container api → http://jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_METRICS_EXPORT_INTERVAL_MS=15000
# Texto user/assistant en tags del span chat.handle (local). Off en prod.
OTEL_CAPTURE_PAYLOADS=true
OTEL_PAYLOAD_MAX_CHARS=1200

